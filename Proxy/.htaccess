# Reverse proxy front controller.
DirectorySlash Off
DirectoryIndex index.php index.html
Options -Indexes

# Expose the Authorization header to PHP (Apache strips it by default).
CGIPassAuth On
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Admin internals must never be fetched directly.
<FilesMatch "^(config|panel|cache-guard)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect includes directory.
<Directory "admin/includes">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Directory>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hide Proxy folder: redirect /Proxy/* to clean /* (e.g. /Proxy/live -> /live)
    RewriteCond %{THE_REQUEST} \s/Proxy/ [OR]
    RewriteCond %{REQUEST_URI} ^/Proxy/
    RewriteRule ^(.*)$ /$1 [R=301,L]
    RewriteCond %{REQUEST_URI} ^/Proxy$
    RewriteRule ^$ / [R=301,L]

    # Preserve the Authorization header across internal rewrites
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Hidden admin panel: every /admin path goes to its front controller
    RewriteRule ^admin$ admin/index.php [L,QSA]
    RewriteRule ^admin/(.*)$ admin/index.php [L,QSA]

    # Setup installer
    RewriteRule ^setup/?$ setup.php [L,QSA]
    RewriteRule ^setup/(.*)$ setup.php [L,QSA]

    # Payment API endpoints
    RewriteRule ^api/(.*)$ api/$1 [L,QSA]

    # Proxy root (with or without trailing slash)
    RewriteRule ^$ index.php [L]

    # Static VoucherCenter page (with or without trailing slash)
    RewriteRule ^VoucherCenter/?$ VoucherCenter/index.html [L]

    # The cache directory is never fetched over HTTP, whatever else is on disk:
    # cached bytes must go out through index.php so they get rewritten, and the
    # per-session subdirectories hold one visitor's data. Layer one of two - the
    # other is cache/.htaccess, which says the same thing to servers that never
    # read this file.
    RewriteRule ^cache/ - [F,L]

    # Serve real files/directories as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the proxy
    RewriteRule ^ index.php [L,QSA]
</IfModule>
