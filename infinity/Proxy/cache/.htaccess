# Cached upstream copies must only ever be served through index.php, which
# applies the brand/content patches (e.g. the affiliate-redirect fix).
# Serving them straight off disk would hand out the raw upstream file.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
