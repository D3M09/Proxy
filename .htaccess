# =============================================================================
#  Root router -> Proxy reverse proxy
#  Routes everything to Proxy/index.php so root-absolute asset/API paths
#  (/res, /common, /wps, /lgw, ...) resolve even when the app lives in /Proxy/.
# =============================================================================

DirectorySlash On
DirectoryIndex index.php

# Add the trailing slash for the app folder (subdirectory installs)
RedirectMatch 301 ^/Proxy$ /Proxy/

# Expose the Authorization header to PHP (Apache strips it by default).
CGIPassAuth On
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Preserve the Authorization header across internal rewrites
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Hide Proxy folder: redirect /Proxy/* to clean /* (e.g. /Proxy/live -> /live)
    RewriteRule ^Proxy/(.*)$ /$1 [R=301,L]

    # Proxy app root (with or without trailing slash) - redirect to clean root
    RewriteRule ^Proxy/?$ / [R=301,L]

    # Test redirect for debugging
    RewriteRule ^test_clean$ / [R=302,L]

    # Mobile typo redirects: /m and /m/hoem -> correct URLs
    RewriteRule ^m$ /m/index.html [R=301,L]
    RewriteRule ^m/$ /m/index.html [R=301,L]
    RewriteRule ^m/hoem/?$ /m/home [R=301,L]

    # Local shortcut: /admin -> the proxy's hidden admin panel
    RewriteRule ^admin(/.*)?$ Proxy/admin/index.php [L,QSA]

    # Local shortcut: /setup -> the installer
    RewriteRule ^setup(/.*)?$ Proxy/setup.php [L,QSA]

    # Offload static /res to upstream CDN (faster than PHP proxy when cache disabled)
    RewriteCond %{REQUEST_URI} ^/res/
    RewriteRule ^res/(.*)$ https://www.1333bk.com/res/$1 [R=302,L]

    # Payment API endpoints
    RewriteRule ^api/(.*)$ Proxy/api/$1 [L,QSA]

    # Real files/directories (except the document root) are served as-is
    RewriteCond %{REQUEST_URI} !=/
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the proxy (clean URLs, hide Proxy) - use index_final to bypass cache
    RewriteRule ^ Proxy/index_final.php [L,QSA]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "same-origin"
</IfModule>
